---
import { getEmDashCollection } from "../../query.js";
import { getSiteSetting } from "../../settings/index.js";
import EmDashImage from "../EmDashImage.astro";
import {
	formatPublishedDate,
	getThumbnailImage,
	toPublishedDate,
} from "../../widgets/recent-posts.js";

interface Props {
	count?: number;
	showThumbnails?: boolean;
	showDate?: boolean;
}

const { count = 5, showThumbnails = false, showDate = true } = Astro.props;

const [{ entries: posts }, timezone, dateFormat] = await Promise.all([
	getEmDashCollection("posts", {
		limit: count,
		orderBy: { published_at: "desc" },
	}),
	getSiteSetting("timezone"),
	getSiteSetting("dateFormat"),
]);

function getTitle(data: Record<string, unknown>): string | undefined {
	return typeof data.title === "string" ? data.title : undefined;
}
---

<ul class="widget-recent-posts">
	{
		posts.map((post) => {
			const title = getTitle(post.data);
			const publishedAt = toPublishedDate(post.data.publishedAt);
			const featuredImage = getThumbnailImage(post.data.featured_image);
			const renderedDate = publishedAt
				? formatPublishedDate(publishedAt, { timezone, dateFormat })
				: null;
			return (
				<li>
					{showThumbnails && featuredImage && (
						<EmDashImage
							image={featuredImage}
							alt=""
							class="widget-recent-posts__thumbnail"
						/>
					)}
					<a href={`/posts/${post.id}`} class="widget-recent-posts__link">
						{title}
					</a>
					{showDate && renderedDate && (
						<time
							datetime={renderedDate.datetime}
							class="widget-recent-posts__date"
						>
							{renderedDate.display}
						</time>
					)}
				</li>
			);
		})
	}
</ul>
